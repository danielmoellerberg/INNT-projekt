{
  "expo": {
    "name": "Insight-Scan",
    "slug": "Insight-Scan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Tillad $(PRODUCT_NAME) at bruge kameraet til at scanne dine kvitteringer",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Tillad $(PRODUCT_NAME) at hente billeder af kvitteringer fra dine fotos",
          "cameraPermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Tillad $(PRODUCT_NAME) at bruge din placering til at vise supermarkeder i nærheden af dig"
        }
      ]
    ]
  }
}
