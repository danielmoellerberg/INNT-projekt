# Skabelon til miljøvariabler for Insight-Scan.
# Kopier denne fil til .env og indsæt dine egne værdier.

# OBS: Variabler med EXPO_PUBLIC_ bygges ind i appen. De holdes ude af git,
# men ikke ude af appen. Brug derfor en separat AI-nøgle med forbrugsloft.

# Firebase (Projektindstillinger -> Generelt -> Dine apps -> Web-app)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_DATABASE_URL=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Generativ AI (nøgle fra AI-udbyderen, med forbrugsloft)
EXPO_PUBLIC_AI_API_KEY=
