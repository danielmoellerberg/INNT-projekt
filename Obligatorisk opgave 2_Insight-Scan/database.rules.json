{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",

        "profil": {
          "rolle": {
            ".write": "auth != null && auth.uid === $uid && !data.exists()"
          },
          "$felt": {
            ".write": "auth != null && auth.uid === $uid"
          }
        },

        "kvitteringer": {
          "$kvitteringId": {
            ".write": "auth != null && auth.uid === $uid && (!data.exists() || !newData.exists())",
            ".validate": "newData.hasChildren(['butik', 'dato', 'total', 'cashback', 'varer', 'aftryk']) && newData.parent().parent().parent().parent().child('aftryk').child(newData.child('aftryk').val()).val() === true"
          }
        },

        "$andet": {
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    },

    "aftryk": {
      "$aftryk": {
        ".read": "auth != null",
        ".write": "auth != null && !data.exists() && newData.val() === true"
      }
    },

    "offers": {
      ".read": "auth != null",
      "$offerId": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('profil').child('rolle').val() === 'leverandoer' && (!data.exists() || data.child('ownerId').val() === auth.uid) && (!newData.exists() || newData.child('ownerId').val() === auth.uid)"
      }
    }
  }
}
